syntax = "v1"

// ===== 设备类别和标准字段相关类型定义 =====
type (
	// 设备类别信息
	DeviceCategoryInfo {
		Code        string `json:"code"`        // 类别代码（如：temp_humidity_smoke_sensor, ai_box）
		Name        string `json:"name"`        // 中文名称（如：温湿度烟雾传感器）
		NameEn      string `json:"nameEn"`      // 英文名称（如：Temperature Sensor）
		Description string `json:"description"` // 描述
		Icon        string `json:"icon"`        // 图标名称（用于前端展示）
	}

	// 标准字段信息
	StandardFieldInfo {
		Name        string   `json:"name"`                   // 字段名（如：temperature）
		DisplayName string   `json:"displayName"`            // 显示名称（如：温度）
		FieldType   string   `json:"fieldType"`              // 字段类型（string/number/boolean等）
		Unit        string   `json:"unit,omitempty"`         // 单位（如：℃, %, ppm）
		Description string   `json:"description,omitempty"`  // 字段描述
		Required    bool     `json:"required"`               // 是否必填
		MinValue    float64  `json:"minValue,omitempty"`     // 最小值（数值类型）
		MaxValue    float64  `json:"maxValue,omitempty"`     // 最大值（数值类型）
		EnumValues  []string `json:"enumValues,omitempty"`   // 枚举值（枚举类型）
	}
)

// ===== 设备类别和标准字段查询相关类型 =====
type (
	// 获取所有设备类别请求
	GetDeviceCategoriesRequest {}

	// 获取所有设备类别响应
	GetDeviceCategoriesResponse {
		BaseResponse // 基础响应
		Data {
			Categories []DeviceCategoryInfo `json:"categories"` // 设备类别列表
		} `json:"data,omitempty"`
	}

	// 获取标准字段请求
	GetStandardFieldsRequest {
		Category string `path:"category"` // 设备类别代码（如：temp_humidity_smoke_sensor, ai_box）
	}

	// 获取标准字段响应
	GetStandardFieldsResponse {
		BaseResponse // 基础响应
		Data {
			Fields []StandardFieldInfo `json:"fields"` // 标准字段列表
		} `json:"data,omitempty"`
	}
)
